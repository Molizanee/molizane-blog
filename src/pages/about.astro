---
import { Image } from 'astro:assets';
import AvatarImage from '../assets/molizane-avatar.png';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const stack = [
	'Python',
	'Go',
	'Qdrant',
	'PostgreSQL',
	'AWS',
	'GCP',
	'Docker',
	'LangChain',
	'LangGraph',
	'LiteLLM',
	'Langfuse',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About · ${SITE_TITLE}`}
			description="AI Engineer building production-ready LLM applications and autonomous agents."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="top">
				<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
			</div>

			<header class="hero">
				<div class="hero-copy">
					<span class="eyebrow">About</span>
					<h1>I build production-ready LLM applications and autonomous agents.</h1>
					<p class="lede">
						AI Engineer with a background in software engineering, working in the tech industry
						since 2023. Currently at <strong>Arara Tech</strong>, a Grupo Guanabara startup,
						developing AI solutions to modernize the transportation sector.
					</p>
					<div class="actions">
						<a
							href="https://github.com/Molizanee"
							target="_blank"
							rel="noopener"
							class="btn btn--dark"
						>
							GitHub ↗
						</a>
						<a
							href="https://www.linkedin.com/in/david-molizane/?locale=pt"
							target="_blank"
							rel="noopener"
							class="btn btn--dark"
						>
							LinkedIn ↗
						</a>
						<a href="mailto:david.molizane@icloud.com" class="btn btn--dark">Email ↗</a>
					</div>
				</div>
				<figure class="hero-media">
					<Image
						src={AvatarImage}
						alt="David Molizane"
						width={720}
						height={720}
						loading="eager"
					/>
				</figure>
			</header>

			<section class="work">
				<h2>Recent work</h2>
				<div class="work-list" id="work-list">
					{/* Populated dynamically from GitHub API */}
					<div class="work-loading" id="work-loading">Loading repositories...</div>
				</div>
			</section>

			<section class="stack">
				<h2>Tech stack</h2>
				<ul class="stack-list">
					{stack.map((t) => <li>{t}</li>)}
				</ul>
			</section>

			<section class="contact">
				<h2>Contact</h2>
				<dl class="contact-list">
					<div>
						<dt>Email</dt>
						<dd>
							<a href="mailto:david.molizane@icloud.com">david.molizane@icloud.com</a>
						</dd>
					</div>
					<div>
						<dt>GitHub</dt>
						<dd>
							<a href="https://github.com/Molizanee" target="_blank" rel="noopener">
								github.com/Molizanee
							</a>
						</dd>
					</div>
					<div>
						<dt>LinkedIn</dt>
						<dd>
							<a
								href="https://www.linkedin.com/in/david-molizane/?locale=pt"
								target="_blank"
								rel="noopener"
							>
								linkedin.com/in/david-molizane
							</a>
						</dd>
					</div>
				</dl>
			</section>
		</main>
		<Footer />

		<script>
			const GITHUB_USER = 'Molizanee';

			async function getCommitCount(repo: string): Promise<number> {
				const res = await fetch(
					`https://api.github.com/repos/${GITHUB_USER}/${repo}/commits?per_page=1`,
				);
				if (!res.ok) return 0;
				const link = res.headers.get('Link');
				if (!link) {
					const data = await res.json();
					return Array.isArray(data) ? data.length : 0;
				}
				const match = link.match(/page=(\d+)>;\s*rel="last"/);
				return match ? parseInt(match[1], 10) : 1;
			}

			async function loadRepos() {
				const list = document.getElementById('work-list')!;
				const loading = document.getElementById('work-loading')!;

				try {
					const res = await fetch(
						`https://api.github.com/users/${GITHUB_USER}/repos?per_page=100&sort=updated`,
					);
					if (!res.ok) throw new Error('Failed to fetch repos');

					const repos = (await res.json()) as Array<{
						name: string;
						html_url: string;
						description: string | null;
						language: string | null;
					}>;

					// Exclude the profile README repo
					const projects = repos.filter((r) => r.name !== GITHUB_USER);

					const withCounts = await Promise.all(
						projects.map(async (repo) => ({
							...repo,
							commits: await getCommitCount(repo.name),
						})),
					);

					withCounts.sort((a, b) => b.commits - a.commits);
					const top3 = withCounts.slice(0, 3);

					loading.remove();

					for (const repo of top3) {
						const card = document.createElement('a');
						card.href = repo.html_url;
						card.target = '_blank';
						card.rel = 'noopener';
						card.className = 'work-item work-link';

						const title = repo.name
							.replace(/-/g, ' ')
							.replace(/\b\w/g, (c) => c.toUpperCase());

						card.innerHTML = `
							<h3>${title}</h3>
							<p>${repo.description || 'No description.'}</p>
							<span class="work-meta">${repo.language || 'Code'} &middot; ${repo.commits} commits</span>
						`;

						list.appendChild(card);
					}
				} catch {
					loading.textContent = 'Could not load repositories.';
				}
			}

			loadRepos();
		</script>
	</body>
</html>

<style>
	.top {
		padding: 1.5rem 0 2rem;
	}

	.hero {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 3rem;
		align-items: center;
		padding-bottom: 4rem;
		margin-bottom: 4rem;
		border-bottom: 1px solid var(--color-border);
	}
	.hero-copy .eyebrow {
		display: block;
		margin-bottom: 1rem;
	}
	.hero-copy h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(2rem, 4vw + 0.5rem, 3.75rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 1.25rem;
	}
	.lede {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0 0 2rem;
		max-width: 52ch;
	}
	.lede strong {
		color: var(--color-text);
		font-weight: 600;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}
	.hero-media {
		margin: 0;
		justify-self: end;
		width: 100%;
		max-width: 420px;
	}
	.hero-media :global(img) {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}

	section {
		margin-bottom: 4rem;
	}
	section h2 {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.5rem);
		letter-spacing: -0.03em;
		margin: 0 0 2rem;
	}

	.work-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.work-list :global(.work-item) {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 1.75rem;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}
	.work-list :global(.work-item:hover) {
		border-color: var(--color-border-strong);
		box-shadow: var(--shadow-sm);
		transform: translateY(-2px);
	}
	.work-list :global(.work-item h3) {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: var(--text-lg);
		letter-spacing: -0.01em;
		margin: 0 0 0.75rem;
	}
	.work-list :global(.work-item p) {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.65;
		color: var(--color-text-muted);
	}
	.work-loading {
		grid-column: 1 / -1;
		text-align: center;
		padding: 3rem 1rem;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.work-list :global(.work-link) {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.work-list :global(.work-meta) {
		display: block;
		margin-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.stack-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.stack-list li {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: 500;
		padding: 0.5rem 1rem;
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.contact-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin: 0;
	}
	.contact-list > div {
		padding: 1.25rem 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	.contact-list dt {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		margin-bottom: 0.25rem;
	}
	.contact-list dd {
		margin: 0;
		font-size: var(--text-base);
	}
	.contact-list a {
		text-decoration: none;
		color: var(--color-text);
		font-weight: 500;
	}
	.contact-list a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			padding-bottom: 2.5rem;
			margin-bottom: 2.5rem;
		}
		.hero-media {
			display: none;
		}
		.work-list {
			grid-template-columns: 1fr;
		}
		.contact-list {
			grid-template-columns: 1fr;
		}
		section {
			margin-bottom: 2.5rem;
		}
	}
</style>
