---
import { Image } from 'astro:assets';
import AvatarImage from '../assets/molizane-avatar.png';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const stack = [
	'Python',
	'Go',
	'Qdrant',
	'PostgreSQL',
	'AWS',
	'GCP',
	'Docker',
	'LangChain',
	'LangGraph',
	'LiteLLM',
	'Langfuse',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About · ${SITE_TITLE}`}
			description="AI Engineer building production-ready LLM applications and autonomous agents."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="top">
				<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
			</div>

			<header class="hero">
				<div class="hero-copy">
					<span class="eyebrow">About</span>
					<h1>I build production-ready LLM applications and autonomous agents.</h1>
					<p class="lede">
						AI Engineer with a background in software engineering, working in the tech industry
						since 2023. Currently at <strong>Arara Tech</strong> — a Grupo Guanabara startup —
						developing AI solutions to modernize the transportation sector.
					</p>
					<div class="actions">
						<a
							href="https://github.com/Molizanee"
							target="_blank"
							rel="noopener"
							class="btn btn--dark"
						>
							GitHub ↗
						</a>
						<a
							href="https://www.linkedin.com/in/david-molizane/?locale=pt"
							target="_blank"
							rel="noopener"
							class="btn btn--dark"
						>
							LinkedIn ↗
						</a>
						<a href="mailto:david.molizane@icloud.com" class="btn btn--dark">Email ↗</a>
					</div>
				</div>
				<figure class="hero-media">
					<Image
						src={AvatarImage}
						alt="David Molizane"
						width={720}
						height={720}
						loading="eager"
					/>
				</figure>
			</header>

			<section class="work">
				<h2>Recent work</h2>
				<div class="work-list">
					<article class="work-item">
						<h3>Executive-Level AI Agents</h3>
						<p>
							Built a modern <em>Text-to-SQL</em> AI Agent using LangChain, LangGraph, context
							engineering, and a semantic layer. Gives C-level executives instant strategic insights
							and accelerates data-driven business decisions.
						</p>
					</article>
					<article class="work-item">
						<h3>Autonomous Workflows &amp; RAG</h3>
						<p>
							Engineered RAG pipelines from scratch in Python with Qdrant to power autonomous
							agents, automating complex operational workflows and significantly reducing manual
							effort.
						</p>
					</article>
					<article class="work-item">
						<h3>LLMOps &amp; Cost Management</h3>
						<p>
							Implemented observability and cost control practices across distributed AI systems —
							LiteLLM for token management and Langfuse for application evaluations.
						</p>
					</article>
				</div>
			</section>

			<section class="stack">
				<h2>Tech stack</h2>
				<ul class="stack-list">
					{stack.map((t) => <li>{t}</li>)}
				</ul>
			</section>

			<section class="contact">
				<h2>Contact</h2>
				<dl class="contact-list">
					<div>
						<dt>Email</dt>
						<dd>
							<a href="mailto:david.molizane@icloud.com">david.molizane@icloud.com</a>
						</dd>
					</div>
					<div>
						<dt>GitHub</dt>
						<dd>
							<a href="https://github.com/Molizanee" target="_blank" rel="noopener">
								github.com/Molizanee
							</a>
						</dd>
					</div>
					<div>
						<dt>LinkedIn</dt>
						<dd>
							<a
								href="https://www.linkedin.com/in/david-molizane/?locale=pt"
								target="_blank"
								rel="noopener"
							>
								linkedin.com/in/david-molizane
							</a>
						</dd>
					</div>
				</dl>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.top {
		padding: 1.5rem 0 2rem;
	}

	.hero {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 3rem;
		align-items: center;
		padding-bottom: 4rem;
		margin-bottom: 4rem;
		border-bottom: 1px solid var(--color-border);
	}
	.hero-copy .eyebrow {
		display: block;
		margin-bottom: 1rem;
	}
	.hero-copy h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(2rem, 4vw + 0.5rem, 3.75rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 1.25rem;
	}
	.lede {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0 0 2rem;
		max-width: 52ch;
	}
	.lede strong {
		color: var(--color-text);
		font-weight: 600;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}
	.hero-media {
		margin: 0;
		justify-self: end;
		width: 100%;
		max-width: 420px;
	}
	.hero-media :global(img) {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}

	section {
		margin-bottom: 4rem;
	}
	section h2 {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.5rem);
		letter-spacing: -0.03em;
		margin: 0 0 2rem;
	}

	.work-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.work-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 1.75rem;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}
	.work-item:hover {
		border-color: var(--color-border-strong);
		box-shadow: var(--shadow-sm);
		transform: translateY(-2px);
	}
	.work-item h3 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-lg);
		letter-spacing: -0.01em;
		margin: 0 0 0.75rem;
	}
	.work-item p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.65;
		color: var(--color-text-muted);
	}
	.work-item em {
		font-style: italic;
		color: var(--color-text);
	}

	.stack-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.stack-list li {
		font-family: var(--font-ui);
		font-size: var(--text-sm);
		font-weight: 500;
		padding: 0.5rem 1rem;
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.contact-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin: 0;
	}
	.contact-list > div {
		padding: 1.25rem 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	.contact-list dt {
		font-family: var(--font-ui);
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
		margin-bottom: 0.25rem;
	}
	.contact-list dd {
		margin: 0;
		font-size: var(--text-base);
	}
	.contact-list a {
		text-decoration: none;
		color: var(--color-text);
		font-weight: 500;
	}
	.contact-list a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			padding-bottom: 2.5rem;
			margin-bottom: 2.5rem;
		}
		.hero-media {
			order: -1;
			max-width: 280px;
			justify-self: start;
		}
		.work-list {
			grid-template-columns: 1fr;
		}
		.contact-list {
			grid-template-columns: 1fr;
		}
		section {
			margin-bottom: 2.5rem;
		}
	}
</style>
