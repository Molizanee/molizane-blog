---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NotesGraph from '../components/NotesGraph.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-title">
					<span class="eyebrow">A journal</span>
					<h1>Truth over trends.</h1>
				</div>
				<div class="hero-graph">
					<NotesGraph />
				</div>
				<div class="hero-side">
					<p class="hero-lede">
						I'm David — a designer and builder writing essays on craft, product, and the patience
						required to make anything good. Fresh pieces land here first.
					</p>
					<div class="hero-actions">
						<a href="/blog" class="btn btn--dark">Read the blog</a>
						<a href="/about" class="link-arrow">About me</a>
					</div>
				</div>
			</section>

			<section class="latest">
				<header class="section-head">
					<h2>Latest writing</h2>
					<a href="/blog" class="link-arrow">All posts</a>
				</header>
				<div class="latest-grid">
					{
						posts.map((post, i) => (
							<ArticleCard
								href={`/blog/${post.id}/`}
								title={post.data.title}
								pubDate={post.data.pubDate}
								image={post.data.heroImage}
								featured={i === 0}
							/>
						))
					}
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		grid-template-areas:
			'title graph'
			'side  graph';
		align-items: start;
		gap: 2.5rem 3rem;
		padding: 3.5rem 0 4rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 4rem;
	}
	.hero-title {
		grid-area: title;
		align-self: end;
	}
	.hero-title .eyebrow {
		display: block;
		margin-bottom: 1.25rem;
	}
	.hero-title h1 {
		font-size: clamp(2.75rem, 6.5vw + 0.5rem, 6rem);
		letter-spacing: -0.04em;
		line-height: 0.95;
		margin: 0;
	}
	.hero-graph {
		grid-area: graph;
		align-self: center;
		width: 100%;
		max-width: 460px;
		justify-self: end;
	}
	.hero-side {
		grid-area: side;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 52ch;
	}
	.hero-lede {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 1.75rem;
		gap: 1rem;
	}
	.section-head h2 {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
		letter-spacing: -0.03em;
		margin: 0;
	}
	.latest {
		margin-bottom: 5rem;
	}
	.latest-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}
	.latest-grid > :first-child {
		grid-column: 1 / -1;
	}

	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			grid-template-areas:
				'title'
				'graph'
				'side';
			gap: 1.5rem;
			padding: 1.5rem 0 2.5rem;
			margin-bottom: 2.5rem;
		}
		.hero-graph {
			justify-self: center;
			max-width: 340px;
		}
		.hero-side {
			justify-self: start;
			max-width: none;
		}
		.latest-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
