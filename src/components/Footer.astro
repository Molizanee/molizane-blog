---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<span>{SITE_TITLE}</span>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href="/">Home</a>
			<a href="/blog">Blog</a>
			<a href="/about">About</a>
			<a href="/rss.xml">RSS</a>
			<a href="https://github.com/Molizanee/molizane-blog" target="_blank" rel="noopener" aria-label="Source on GitHub">
				<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M10 1a9 9 0 0 0-2.84 17.54c.45.08.62-.2.62-.43v-1.5c-2.52.55-3.05-1.22-3.05-1.22a2.4 2.4 0 0 0-1-1.33c-.82-.56.06-.55.06-.55a1.9 1.9 0 0 1 1.38.93 1.93 1.93 0 0 0 2.63.75 1.93 1.93 0 0 1 .58-1.21c-2.01-.23-4.13-1-4.13-4.5a3.52 3.52 0 0 1 .94-2.44 3.27 3.27 0 0 1 .09-2.41s.77-.25 2.5.93a8.64 8.64 0 0 1 4.56 0c1.74-1.18 2.5-.93 2.5-.93a3.27 3.27 0 0 1 .09 2.41 3.52 3.52 0 0 1 .93 2.44c0 3.5-2.13 4.27-4.15 4.5a2.16 2.16 0 0 1 .62 1.68v2.5c0 .24.16.52.62.43A9 9 0 0 0 10 1Z"/></svg>
			</a>
		</nav>
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-surface);
	}
	.footer-inner {
		max-width: var(--container);
		margin: 0 auto;
		padding: 3rem 1.5rem 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
	}
	.footer-brand {
		font-family: var(--font-sans);
		font-weight: 700;
		color: var(--color-text);
		display: inline-flex;
		align-items: center;
		margin-right: auto;
	}
	.footer-links {
		display: flex;
		gap: 1.5rem;
	}
	.footer-links a {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.footer-links a:hover {
		color: var(--color-text);
	}
	.copy {
		width: 100%;
		margin: 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}
	@media (max-width: 720px) {
		.footer-inner {
			padding: 2rem 1rem 1.5rem;
		}
	}
</style>
